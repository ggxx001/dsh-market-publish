{
  "name": "@ggxx/dsh-market-publish",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "把本地插件一键发布到 GitHub 公开仓库、npm 和 1024store 插件目录：发布前检查、自动建仓推送、加 dsh-plugin 话题。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
